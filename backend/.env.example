# Copy to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=5000

# PostgreSQL connection string.
# Local: `npm run db:local` starts a PostgreSQL using these credentials.
DATABASE_URL=postgresql://optisell:CHANGE_ME@localhost:5432/optisell
# true for hosted databases that require TLS (Neon, Supabase, Render)
DATABASE_SSL=false
DB_STATEMENT_TIMEOUT_MS=15000

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

BCRYPT_ROUNDS=10

# Business timezone for "today" and daily/weekly/monthly reports
APP_TIMEZONE=Asia/Tashkent

# Requests per 15 minutes per IP
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=10

# Number of reverse proxies in front of the API (0 locally; 1 on Render/Railway/Nginx)
TRUST_PROXY=0
