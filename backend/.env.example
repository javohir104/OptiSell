# Copy to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=5000

# PostgreSQL (REQUIRED on Render / any host that wipes its disk on deploy).
# With it, all data is stored in Postgres and survives every push / redeploy.
# Free options: neon.tech or supabase.com -> copy the "connection string" here.
# Empty = data is kept in JSON files in DATA_DIR (fine on your own computer).
DATABASE_URL=

# Where the JSON data files live (users.json, products.json, ...). Empty = backend/data
DATA_DIR=

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

BCRYPT_ROUNDS=10

# Business timezone for "today" and daily/weekly/monthly reports
APP_TIMEZONE=Asia/Tashkent

# Requests per 15 minutes per IP
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=10

# Number of reverse proxies in front of the API (0 locally; 1 on Render/Railway/Nginx)
TRUST_PROXY=0

# --- Subscriptions & payments ---
# false = plans are shown but cannot be bought (payments not integrated yet).
PAYMENTS_ENABLED=false
# Where Click / Payme send the user back after paying (frontend billing page).
PAYMENTS_RETURN_URL=http://localhost:5173/billing
# true ONLY for local testing: shows a "Test payment" button that activates a plan for free.
PAYMENTS_TEST_MODE=false
# Click merchant cabinet (merchant.click.uz). Callback URLs: <API>/api/payments/click/prepare and /complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Payme merchant cabinet (merchant.paycom.uz). Endpoint URL: <API>/api/payments/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
# true = checkout.test.paycom.uz (sandbox)
PAYME_TEST=false

# --- Google sign-in ---
# OAuth 2.0 Client ID (Web application) from https://console.cloud.google.com/apis/credentials
# Must be the same value as VITE_GOOGLE_CLIENT_ID in frontend/.env. Empty = Google sign-in off.
GOOGLE_CLIENT_ID=725663023320-okl26be62rntb4uhs8dsq9vdg1ie39qj.apps.googleusercontent.com

# --- Admin panel (/admin) ---
# This account gets role=admin on every backend start (sign in on the normal /login page).
# Password: 12+ characters. Generate: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_EMAIL=
ADMIN_PASSWORD=
# --- Backups (backend/data/backups; restored automatically if a data file is damaged) ---
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# --- Telegram notifications (Max plan: daily report + low-stock alerts) ---
# Same bot token as telegram-bot/.env. Empty = notifications off.
TELEGRAM_BOT_TOKEN=
# Bot username without @ (used for the "Connect Telegram" link)
TELEGRAM_BOT_USERNAME=OptiSell1_bot
# Shared secret with the bot (same value as TELEGRAM_LINK_SECRET in telegram-bot/.env)
TELEGRAM_LINK_SECRET=
# Local hour (APP_TIMEZONE) when the daily report is sent
DAILY_REPORT_HOUR=21
