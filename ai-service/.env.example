# Copy to .env (or set in your process manager / Docker) — never commit real secrets.
OPTISELL_AI_ENV=development

# Shared secret the OptiSell backend sends in the X-API-Key header.
# Leave empty ONLY for local development (auth disabled).
OPTISELL_AI_API_KEY=b7898eccbbb37e2d33bff25ce519e3cd2865e60016b09942445e742903409ccf


# Comma-separated origins. Usually empty: the browser talks to the backend, not to this service.
OPTISELL_AI_CORS_ORIGINS=

OPTISELL_AI_MAX_HISTORY_DAYS=730
OPTISELL_AI_MAX_BATCH_SIZE=200
OPTISELL_AI_MAX_HORIZON_DAYS=90
