# Base URL of the OptiSell backend (../backend).
# /api = through the Vite proxy (needed for Telegram / phone via a tunnel).
VITE_API_URL=https://optisell-backend.onrender.com/api


# "Sign in with Google": OAuth 2.0 Client ID (public, not a secret). Same value as GOOGLE_CLIENT_ID in
# backend/.env. Empty = no Google button.
VITE_GOOGLE_CLIENT_ID=725663023320-okl26be62rntb4uhs8dsq9vdg1ie39qj.apps.googleusercontent.com

# Money is always shown in Uzbek so'm (UZS).

# NEVER put secrets / JWT signing keys here — everything prefixed VITE_ is public.

# Telegram Mini App: Google sign-in opens in the external browser on this address. Must be in Google
# Console "Authorized JavaScript origins". Empty = http://localhost:5173 in dev, the site itself in a build.
VITE_GOOGLE_HANDOFF_ORIGIN=https://opti-selll.vercel.app/

# Shops map: Google Maps JavaScript API key (public, restrict it to your sites in Google Console).
# Empty = the map uses OpenStreetMap instead.
VITE_GOOGLE_MAPS_API_KEY=
