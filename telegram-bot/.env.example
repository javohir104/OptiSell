# Token from @BotFather. NEVER commit .env.
BOT_TOKEN=

# Public HTTPS address of the frontend (Telegram opens only https:// Mini Apps).
# Local dev: `npm run local` starts a tunnel and fills this in automatically.
# Production: your deployed frontend, e.g. https://optisell.vercel.app
WEBAPP_URL=https://opti-selll.vercel.app

# --- Telegram notifications (daily report, low-stock alerts) ---
# Backend address the bot calls when a user presses "Connect Telegram" in OptiSell.
# Local: http://localhost:5000   Production: https://your-backend.example.com
BACKEND_URL=http://localhost:5000
# Long random string, the SAME value as TELEGRAM_LINK_SECRET in backend/.env.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_LINK_SECRET=
